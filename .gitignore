# Environment
.env
.env.*
!.env.example
config.json

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Dependencies
node_modules/

# Build output
dist/
build/
out/
target/
*.spec

# Tauri sidecar binaries (generated/placeholder)
frontend/src-tauri/binaries/*.exe

# Tauri generated code
frontend/src-tauri/gen/

# Local dev files (directory tracked, contents ignored)
.local/*
!.local/.gitkeep

# Secrets drop (never commit)
docs/keys.md

# Background-agent worktrees (contents ignored, folder allowed)
.claude/worktrees/*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
