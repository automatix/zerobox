# Zerobox — secret credentials
# Copy this file to .env and fill in your keys.

# Required if llm.provider = "anthropic" (default)
ANTHROPIC_API_KEY=sk-ant-...

# Required if llm.provider = "openai"
OPENAI_API_KEY=sk-...

# Required if llm.provider = "ollama" (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
