{
  "$schema": "https://raw.githubusercontent.com/nicklimmern/tauri-v2/main/tooling/cli/schema.json",
  "productName": "zerobox",
  "version": "0.7.0",
  "identifier": "com.zerobox.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zerobox",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/zerobox-backend"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "resources": [
      "resources/*"
    ]
  }
}
